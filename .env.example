# Configuración local del sistema integrado. Copiar a .env, nunca publicarlo.
RAG_MODE=live
RAG_BACKEND_FACTORY=etapa3_producto.vector_backend:create_backend
# Obligatoria: clave de Mistral para embeddings (no la clave de Groq).
MISTRAL_API_KEY=
# Opciones del motor, mantener estos valores para el índice de 1024 dimensiones.
MISTRAL_BASE_URL=https://api.mistral.ai/v1
MISTRAL_EMBED_MODEL=mistral-embed
# Obligatoria: clave de Groq para generar respuestas y usar memoria.
LLM_API_KEY=
# Alternativa opcional para etapa 3; no hace falta si LLM_API_KEY está definida.
# La CLI independiente de etapa 2 requiere LLM_API_KEY.
GROQ_API_KEY=
LLM_BASE_URL=https://api.groq.com/openai/v1
LLM_MODEL=qwen/qwen3.6-27b
LLM_MAX_TOKENS=512

# Obligatoria: contraseña propia (se recomienda hexadecimal), no usar CAMBIAR.
# La URL es para scripts ejecutados desde Windows; Compose usa el host interno db.
POSTGRES_PASSWORD=
DATABASE_URL=postgresql://rag:CAMBIAR@127.0.0.1:5433/ley21719
# Compatibilidad con etapa2; en Compose raíz estos valores están fijados.
# No levantar ambos Compose simultáneamente ni cambiar estos valores en raíz.
POSTGRES_USER=rag
POSTGRES_DB=ley21719
POSTGRES_PORT=5433
